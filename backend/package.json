{
  "name": "kanab-motors-backend",
  "version": "1.0.0",
  "description": "KANAB Motors Sales, Inventory & Customer Account Management System - Backend API",
  "author": "Sky Link Technologies PLC",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node --max-semi-space-size=128 ./node_modules/@nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node --max-semi-space-size=128 ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --max-semi-space-size=128 ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --max-semi-space-size=128 ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/main",
    "typeorm": "node --max-semi-space-size=128 ./node_modules/ts-node/dist/bin.js -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:win": "node --max-semi-space-size=128 ./node_modules/ts-node/dist/bin.js -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/config/data-source.ts",
    "migration:run": "npm run typeorm:win -- migration:run",
    "migration:revert": "npm run typeorm:win -- migration:revert",
    "migration:generate": "npm run typeorm:win -- migration:generate",
    "seed": "node --max-semi-space-size=128 ./node_modules/ts-node/dist/bin.js -r tsconfig-paths/register ./src/database/seed.ts",
    "test": "node --max-semi-space-size=128 ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --max-semi-space-size=128 ./node_modules/jest/bin/jest.js --watch --runInBand",
    "test:cov": "node --max-semi-space-size=128 ./node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.5.6",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
